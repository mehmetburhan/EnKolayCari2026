<div class="flex min-h-screen bg-white">
    <div class="flex w-full flex-col justify-center px-6 py-12 sm:px-12 lg:w-[440px] lg:flex-none xl:w-[480px]">
        <div class="mx-auto w-full max-w-sm">
            <div class="flex items-center gap-2.5">
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand to-violet text-sm font-bold text-white">EK</span>
                <span class="text-xl font-semibold text-slate-900">EnKolayCari</span>
            </div>

            <h1 class="mt-8 text-2xl font-bold text-slate-900">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="mt-1.5 text-sm text-slate-500">@Subtitle</p>
            }

            <div class="mt-8">
                @ChildContent
            </div>
        </div>
    </div>

    <div class="relative hidden flex-1 overflow-hidden bg-gradient-to-br from-nexora-950 via-nexora-900 to-nexora-950 lg:flex">
        <div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-[var(--nexora-blue)] opacity-20 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 -right-16 h-96 w-96 rounded-full bg-[var(--nexora-violet)] opacity-20 blur-3xl"></div>
        <div class="pointer-events-none absolute right-1/3 top-1/3 h-72 w-72 rounded-full bg-[var(--nexora-teal)] opacity-10 blur-3xl"></div>

        <div class="relative z-10 flex w-full flex-col justify-center px-12 py-16 xl:px-20">
            <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--nexora-teal)]">Tek Platform, Tüm İşletme</p>
            <h2 class="mt-4 max-w-md text-3xl font-bold leading-tight text-white xl:text-4xl">İşinizi tek ekrandan yönetin</h2>
            <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-300">
                Cari, stok, fatura, e-fatura ve banka işlemlerinizi EnKolayCari ile tek panelden kolayca yönetin.
            </p>

            <div class="mt-10 grid grid-cols-2 gap-4">
                @foreach (var module in Modules)
                {
                    <div class="auth-module-card">
                        <span class="grid h-9 w-9 place-items-center rounded-lg bg-white/10 text-white">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)module.IconSvg)</svg>
                        </span>
                        <p class="mt-3 text-sm font-semibold text-white">@module.Title</p>
                        <p class="mt-1 text-xs leading-relaxed text-slate-400">@module.Description</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static readonly (string Title, string Description, string IconSvg)[] Modules =
    [
        ("Cari & Tedarikçi", "Müşteri ve tedarikçi hesaplarını tek yerden takip edin.", MenuIcons.Users),
        ("Stok & Depo", "Depo hareketlerini ve stok seviyelerini anlık izleyin.", MenuIcons.ArchiveBox),
        ("Fatura & E-Fatura", "Satış, alış ve e-fatura süreçlerini hızlandırın.", MenuIcons.DocumentText),
        ("Banka & Kasa", "Kasa, banka ve çek işlemlerinizi tek ekrandan yönetin.", MenuIcons.BuildingLibrary),
    ];
}
