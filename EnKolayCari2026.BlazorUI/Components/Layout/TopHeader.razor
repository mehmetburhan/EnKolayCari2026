@inject PageHeadingState HeadingState
@implements IDisposable

<header class="sticky top-0 z-30 flex items-center justify-between gap-3 border-b border-[var(--nexora-border)] bg-[#f5f7fb]/90 px-4 py-4 backdrop-blur sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center gap-3">
        <button type="button"
                class="icon-button icon-button--mobile lg:hidden"
                aria-expanded="@IsMenuOpen.ToString().ToLowerInvariant()"
                @onclick="() => OnMenuToggle.InvokeAsync()">
            <span class="sr-only">Menuyu ac</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
        </button>

        <div class="min-w-0">
            <h1 class="truncate text-xl font-bold text-slate-900 sm:text-2xl">@HeadingState.Title</h1>
            @if (!string.IsNullOrWhiteSpace(HeadingState.Subtitle))
            {
                <p class="mt-0.5 truncate text-sm text-slate-500">@HeadingState.Subtitle</p>
            }
        </div>
    </div>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <button type="button" class="icon-button hidden sm:grid" aria-label="Ara">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
        </button>

        <button type="button" class="icon-button" aria-label="Bildirimler">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
            <span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-red-500"></span>
        </button>

        <button type="button" class="icon-button hidden sm:grid" aria-label="Mesajlar">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
        </button>

        <NavLink href="" Match="NavLinkMatch.All" class="dashboard-button-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            <span class="hidden sm:inline">Yeni Kayit</span>
        </NavLink>
    </div>
</header>

@code {
    [Parameter]
    public bool IsMenuOpen { get; set; }

    [Parameter]
    public EventCallback OnMenuToggle { get; set; }

    protected override void OnInitialized()
    {
        HeadingState.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        HeadingState.Changed -= StateHasChanged;
    }
}
