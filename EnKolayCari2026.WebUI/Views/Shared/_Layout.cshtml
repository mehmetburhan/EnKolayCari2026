<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnKolayCari2026</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[#f5f7fb] font-sans text-slate-900">
    <div class="flex min-h-screen">
        <aside class="desktop-sidebar sticky top-0 hidden h-screen w-64 shrink-0 lg:block">
            <partial name="_Sidebar" />
        </aside>

        <div id="mobile-sidebar" class="fixed inset-0 z-50 hidden lg:hidden" aria-hidden="true">
            <div id="mobile-sidebar-backdrop" class="absolute inset-0 bg-slate-900/50"></div>
            <aside class="relative h-full w-64 max-w-[80%]">
                <partial name="_Sidebar" />
            </aside>
        </div>

        <div class="flex min-h-screen min-w-0 flex-1 flex-col">
            <partial name="_Header" />

            <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
                @RenderBody()
            </main>

            <footer class="border-t border-[var(--nexora-border)] px-4 py-4 text-sm text-slate-500 sm:px-6 lg:px-8">
                &copy; 2026 - EnKolayCari2026 -
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-[var(--nexora-blue)] hover:underline">Gizlilik</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
