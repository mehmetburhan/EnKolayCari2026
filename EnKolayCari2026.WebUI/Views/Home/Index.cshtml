@model DashboardViewModel
@{
    ViewData["Title"] = "Panel";
}

<div class="space-y-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="card kpi-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-900">Toplam Ciro</p>
                    <p class="text-xs text-slate-500">Bu Ay</p>
                </div>
                <span class="kpi-icon kpi-icon--teal">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 3.75c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-end justify-between gap-2">
                <div>
                    <p class="kpi-change">
                        <svg class="mr-0.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
                        @Model.TotalRevenue.ChangeLabel
                    </p>
                    <p class="kpi-value font-bold text-slate-900">@Model.TotalRevenue.ValueLabel</p>
                </div>
                <svg class="h-9 w-24 text-[var(--nexora-teal)]" viewBox="0 0 120 40" fill="none" preserveAspectRatio="none">
                    <polyline points="0,28 15,22 30,25 45,15 60,20 75,10 90,14 105,6 120,10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>

        <div class="card kpi-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-900">Yeni Musteri</p>
                    <p class="text-xs text-slate-500">Bu Ay</p>
                </div>
                <span class="kpi-icon kpi-icon--violet">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-end justify-between gap-2">
                <div>
                    <p class="kpi-change">
                        <svg class="mr-0.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
                        @Model.NewCustomers.ChangeLabel
                    </p>
                    <p class="kpi-value font-bold text-slate-900">@Model.NewCustomers.ValueLabel</p>
                </div>
                <svg class="h-9 w-24" viewBox="0 0 120 40" preserveAspectRatio="none">
                    @{
                        int[] bars = [12, 18, 14, 22, 16, 26, 20, 30, 24, 34, 28, 36];
                    }
                    @for (var i = 0; i < bars.Length; i++)
                    {
                        <rect x="@(i * 10)" y="@(40 - bars[i])" width="6" height="@bars[i]" rx="1.5" fill="var(--nexora-violet)" />
                    }
                </svg>
            </div>
        </div>

        <div class="card kpi-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-900">Donusum Orani</p>
                    <p class="text-xs text-slate-500">Bu Ay</p>
                </div>
                <span class="kpi-icon kpi-icon--orange">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 17.25a5.25 5.25 0 1 0 0-10.5 5.25 5.25 0 0 0 0 10.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-end justify-between gap-2">
                <div>
                    <p class="kpi-change">
                        <svg class="mr-0.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
                        @Model.ConversionRate.ChangeLabel
                    </p>
                    <p class="kpi-value font-bold text-slate-900">@Model.ConversionRate.ValueLabel</p>
                </div>
                <svg class="h-9 w-24 text-[var(--nexora-orange)]" viewBox="0 0 120 40" fill="none" preserveAspectRatio="none">
                    <polyline points="0,32 15,28 30,30 45,22 60,18 75,20 90,12 105,8 120,4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>

        <div class="card kpi-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-900">Tamamlanan Siparis</p>
                    <p class="text-xs text-slate-500">Bu Ay</p>
                </div>
                <span class="kpi-icon kpi-icon--blue">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-end justify-between gap-2">
                <div>
                    <p class="kpi-change">
                        <svg class="mr-0.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
                        @Model.OrdersCompleted.ChangeLabel
                    </p>
                    <p class="kpi-value font-bold text-slate-900">@Model.OrdersCompleted.ValueLabel</p>
                </div>
                <svg class="h-9 w-24 text-[var(--nexora-blue)]" viewBox="0 0 120 40" fill="none" preserveAspectRatio="none">
                    <polyline points="0,20 12,26 24,18 36,24 48,14 60,22 72,12 84,18 96,10 108,16 120,8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-5">
        <div class="card p-5 xl:col-span-2">
            <div class="flex items-start justify-between">
                <div>
                    <h2 class="text-base font-semibold text-slate-900">Hesap Ozeti</h2>
                    <p class="text-xs text-slate-500">Toplam Bakiye</p>
                </div>
                <button type="button" class="button-secondary">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    Bakiye Ekle
                </button>
            </div>
            <p class="mt-2 text-3xl font-bold text-slate-900">@Model.TotalBalanceLabel</p>

            <div class="mt-5 grid grid-cols-2 gap-3">
                @foreach (var account in Model.CurrencyAccounts)
                {
                    <div class="currency-card">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-500">@account.CountryCode</span>
                            <button type="button" class="text-slate-400 hover:text-slate-600" aria-label="Daha fazla">
                                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm0 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM10 14a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z" /></svg>
                            </button>
                        </div>
                        <p class="mt-2 text-sm font-medium text-slate-500">@account.CurrencyCode</p>
                        <p class="mt-1 text-lg font-bold text-slate-900">@account.AmountLabel</p>
                        <p class="mt-1 text-xs font-medium text-emerald-600">Kullanilabilir</p>
                    </div>
                }
            </div>
        </div>

        <div class="card p-5 xl:col-span-3">
            <div class="flex items-start justify-between">
                <h2 class="text-base font-semibold text-slate-900">Ciro Genel Bakis</h2>
                <select class="rounded-lg border border-[var(--nexora-border)] px-3 py-1.5 text-xs font-medium text-slate-700">
                    <option>Bu Ceyrek</option>
                    <option>Bu Yil</option>
                </select>
            </div>

            <div class="mt-4 overflow-x-auto">
                <svg viewBox="0 0 680 260" class="h-64 w-full min-w-[480px]" preserveAspectRatio="none">
                    <line x1="0" y1="20" x2="680" y2="20" stroke="var(--nexora-border)" stroke-dasharray="3 3" />
                    <line x1="0" y1="75" x2="680" y2="75" stroke="var(--nexora-border)" stroke-dasharray="3 3" />
                    <line x1="0" y1="130" x2="680" y2="130" stroke="var(--nexora-border)" stroke-dasharray="3 3" />
                    <line x1="0" y1="185" x2="680" y2="185" stroke="var(--nexora-border)" stroke-dasharray="3 3" />
                    <line x1="0" y1="240" x2="680" y2="240" stroke="var(--nexora-border)" />

                    <polyline points="0,185 110,152 220,116 330,97 440,75 550,59 660,48" fill="none" stroke="var(--nexora-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <polyline points="0,213 110,196 220,174 330,158 440,141 550,119 660,103" fill="none" stroke="var(--nexora-violet)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <polyline points="0,226 110,215 220,202 330,191 440,174 550,158 660,147" fill="none" stroke="var(--nexora-teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                    @{
                        int[] xs = [0, 110, 220, 330, 440, 550, 660];
                        int[] revenueYs = [185, 152, 116, 97, 75, 59, 48];
                        int[] expenseYs = [213, 196, 174, 158, 141, 119, 103];
                        int[] profitYs = [226, 215, 202, 191, 174, 158, 147];
                    }
                    @for (var i = 0; i < xs.Length; i++)
                    {
                        <circle cx="@xs[i]" cy="@revenueYs[i]" r="3.5" fill="var(--nexora-blue)" />
                        <circle cx="@xs[i]" cy="@expenseYs[i]" r="3.5" fill="var(--nexora-violet)" />
                        <circle cx="@xs[i]" cy="@profitYs[i]" r="3.5" fill="var(--nexora-teal)" />
                    }
                </svg>
                <div class="mt-1 flex justify-between text-xs text-slate-400">
                    <span>Tem</span>
                    <span>Agu</span>
                    <span>Eyl</span>
                    <span>Eki</span>
                </div>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-medium text-slate-600">
                <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--nexora-blue)]"></span>Ciro</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--nexora-violet)]"></span>Gider</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--nexora-teal)]"></span>Kar</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-5">
        <div class="card p-5 xl:col-span-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <button type="button" class="tab-button tab-button--active">Son Islemler</button>
                    <button type="button" class="tab-button">Bekleyen</button>
                    <button type="button" class="tab-button">Basarisiz</button>
                </div>
                <a href="#" class="text-xs font-semibold text-[var(--nexora-blue)] hover:underline">Tumunu Gor</a>
            </div>

            <div class="mt-4 overflow-x-auto">
                <table class="w-full min-w-[560px] text-left text-sm">
                    <thead>
                        <tr class="text-xs font-semibold text-slate-500">
                            <th class="pb-2 font-medium">Aciklama</th>
                            <th class="pb-2 font-medium">Tur</th>
                            <th class="pb-2 font-medium">Tarih</th>
                            <th class="pb-2 font-medium">Tutar</th>
                            <th class="pb-2 font-medium">Durum</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--nexora-border)]">
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr>
                                <td class="py-2.5 font-medium text-slate-900">@tx.Description</td>
                                <td class="py-2.5 text-slate-500">@tx.Type</td>
                                <td class="py-2.5 text-slate-500">@tx.DateLabel</td>
                                <td class="py-2.5 font-medium @(tx.IsPositive ? "text-emerald-600" : "text-red-600")">@tx.AmountLabel</td>
                                <td class="py-2.5">
                                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold @(tx.IsStatusSuccess ? "bg-emerald-50 text-emerald-600" : "bg-blue-50 text-[var(--nexora-blue)]")">@tx.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card p-5 xl:col-span-2">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-semibold text-slate-900">Hedefler ve Ilerleme</h2>
                <button type="button" class="icon-button icon-button--mobile h-8 w-8" aria-label="Hedef ekle">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                </button>
            </div>

            <div class="mt-4 space-y-5">
                @foreach (var goal in Model.Goals)
                {
                    <div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-medium text-slate-900">@goal.Title</span>
                            <span class="font-semibold text-slate-900">@(goal.PercentComplete)%</span>
                        </div>
                        <p class="text-xs text-slate-500">@goal.CurrentLabel / @goal.TargetLabel</p>
                        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                            <div class="h-full rounded-full @goal.AccentClass" style="width: @(goal.PercentComplete)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
