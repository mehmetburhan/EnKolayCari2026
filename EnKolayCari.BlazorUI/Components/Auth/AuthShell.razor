<div class="flex h-screen overflow-hidden bg-white">
    <div class="order-2 flex w-full flex-col justify-center px-6 py-12 sm:px-12 lg:w-[440px] lg:flex-none xl:w-[480px]">
        <div class="mx-auto w-full max-w-sm">
            <div class="flex items-center gap-2.5">
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand to-violet text-sm font-bold text-white">EK</span>
                <span class="text-xl font-semibold text-slate-900">EnKolayCari</span>
            </div>

            <h1 class="mt-8 text-3xl font-extrabold leading-tight text-slate-900">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="mt-1.5 text-sm text-slate-500">@Subtitle</p>
            }

            <div class="mt-8">
                @ChildContent
            </div>
        </div>
    </div>

    <div class="order-1 relative hidden flex-1 overflow-hidden bg-gradient-to-br from-nexora-950 via-nexora-900 to-nexora-950 lg:flex">
        <div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-[var(--nexora-blue)] opacity-20 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 -right-16 h-96 w-96 rounded-full bg-[var(--nexora-violet)] opacity-20 blur-3xl"></div>
        <div class="pointer-events-none absolute right-1/3 top-1/3 h-72 w-72 rounded-full bg-[var(--nexora-teal)] opacity-10 blur-3xl"></div>

        <div class="relative z-10 hidden items-center gap-2 xl:absolute xl:right-16 xl:top-10 xl:flex">
            <p class="text-xs text-slate-400">İşinizi kolaylaştıran çözümler</p>
            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">@((MarkupString)MenuIcons.ArrowRight)</svg>
        </div>

        <div class="relative z-10 flex h-full w-full flex-col justify-start px-12 pt-18 pb-6 xl:px-20">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[.15em] text-white/80">
                <svg class="h-3.5 w-3.5 text-[var(--nexora-blue)]" fill="currentColor" viewBox="0 0 24 24">@((MarkupString)MenuIcons.Bolt)</svg>
                Tek Platform, Tüm İşlemler
            </span>

            <h2 class="mt-3 max-w-md text-3xl font-bold leading-tight text-white xl:text-4xl">
                İşinizi tek ekrandan
                <span class="bg-gradient-to-r from-[var(--nexora-blue)] to-[var(--nexora-violet)] bg-clip-text text-transparent">yönetin</span>
            </h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-300">
                Cari, stok, fatura, e-fatura ve banka işlemlerinizi EnKolayCari ile tek panelden kolayca yönetin.
            </p>

            <div class="mt-6 flex flex-col gap-6 2xl:flex-row 2xl:items-start 2xl:gap-10">
                <div class="grid grid-cols-2 gap-4">
                    @foreach (var module in Modules)
                    {
                        <div class="auth-module-card">
                            <span class="grid h-9 w-9 place-items-center rounded-lg text-white" style="background:@module.IconColor">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)module.IconSvg)</svg>
                            </span>
                            <p class="mt-3 text-sm font-semibold text-white">@module.Title</p>
                            <p class="mt-1 text-xs leading-relaxed text-slate-400">@module.Description</p>
                        </div>
                    }
                </div>

                <div class="auth-mockup-neon hidden w-[460px] flex-none self-start rotate-2 rounded-3xl bg-white p-4 text-left 2xl:block">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
                        <div class="flex items-center gap-2.5">
                            <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-brand to-violet text-xs font-bold text-white">EK</span>
                            <span class="text-sm font-semibold text-slate-700">EnKolayCari</span>
                        </div>
                        <span class="grid h-8 w-8 place-items-center rounded-full bg-slate-100 text-slate-400">
                            <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.UserCircle)</svg>
                        </span>
                    </div>

                    <div class="mt-2 grid grid-cols-2 gap-2">
                        @foreach (var stat in MockStats)
                        {
                            <div class="rounded-xl border border-slate-100 p-2">
                                <p class="text-xs text-slate-400">@stat.Label</p>
                                <p class="text-base font-bold text-slate-900">@stat.Value</p>
                                <p class="text-xs font-semibold text-emerald-500">▲ @stat.Change</p>
                            </div>
                        }
                    </div>

                    <div class="mt-2 rounded-xl border border-slate-100 p-2">
                        <p class="text-xs text-slate-400">Son 7 Günlük Satışlar</p>
                        <svg viewBox="0 0 200 50" preserveAspectRatio="none" class="mt-1 h-10 w-full text-[var(--nexora-blue)]">
                            <polyline points="0,38 25,30 50,34 75,18 100,26 125,12 150,20 175,8 200,14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>

                    <div class="mt-2 rounded-xl border border-slate-100 p-2">
                        <p class="text-xs font-medium text-slate-500">Son İşlemler</p>
                        <div class="mt-1.5 space-y-1">
                            @foreach (var tx in RecentTransactions)
                            {
                                <div class="flex items-center gap-2">
                                    <span class="grid h-7 w-7 flex-none place-items-center rounded-lg text-white" style="background:@tx.IconColor">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)tx.IconSvg)</svg>
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-xs font-semibold text-slate-700">@tx.Title</p>
                                        <p class="text-[10px] text-slate-400">@tx.Meta</p>
                                    </div>
                                    <p class="flex-none text-xs font-semibold text-slate-900">@tx.Amount</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-2 flex items-center gap-2 rounded-xl bg-slate-50 p-2">
                        <svg class="h-4 w-4 flex-none text-[var(--nexora-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.ShieldCheck)</svg>
                        <p class="text-xs font-medium text-slate-500">Tüm işlemleriniz güvenli ve hızlı</p>
                    </div>
                </div>
            </div>

            <div class="mt-auto flex flex-none items-center gap-8 border-t border-white/10 pt-4">
                @foreach (var highlight in Highlights)
                {
                    <div class="flex items-center gap-2.5">
                        <svg class="h-5 w-5 flex-none text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)highlight.IconSvg)</svg>
                        <div>
                            <p class="text-xs font-semibold text-white">@highlight.Title</p>
                            <p class="text-[11px] text-slate-400">@highlight.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static readonly (string Title, string Description, string IconSvg, string IconColor)[] Modules =
    [
        ("Cari & Tedarikçi", "Müşteri ve tedarikçi hesaplarını tek yerden takip edin.", MenuIcons.Users, "var(--nexora-blue)"),
        ("Stok & Depo", "Depo hareketlerini ve stok seviyelerini anlık izleyin.", MenuIcons.ArchiveBox, "var(--nexora-teal)"),
        ("Fatura & E-Fatura", "Satış, alış ve e-fatura süreçlerini hızlandırın.", MenuIcons.DocumentText, "var(--nexora-blue)"),
        ("Banka & Kasa", "Kasa, banka ve çek işlemlerinizi tek ekrandan yönetin.", MenuIcons.BuildingLibrary, "var(--nexora-orange)"),
        ("Entegrasyon", "E-ticaret ve banka entegrasyonlarınızı tek noktadan bağlayın.", MenuIcons.Globe, "var(--nexora-violet)"),
        ("Özet Raporlar", "İşletmenizin performansını anlık raporlarla takip edin.", MenuIcons.ChartBar, "var(--nexora-teal)"),
    ];

    private static readonly (string Label, string Value, string Change)[] MockStats =
    [
        ("Toplam Cari", "12.540.000 ₺", "%12"),
        ("Toplam Stok", "3.240.000 ₺", "%8"),
        ("Toplam Fatura", "1.980.000 ₺", "%15"),
        ("Banka Bakiyesi", "680.000 ₺", "%6"),
    ];

    private static readonly (string Title, string Meta, string Amount, string IconSvg, string IconColor)[] RecentTransactions =
    [
        ("Fatura Oluşturuldu", "16.04.2025 · Sales A.Ş.", "289.000 ₺", MenuIcons.DocumentText, "var(--nexora-blue)"),
        ("Cari Hesap Güncellendi", "17.04.2025 · Acme Ltd. Şti.", "126.000 ₺", MenuIcons.Users, "var(--nexora-violet)"),
        ("Stok Girişi", "16.04.2025 · Merkez Depo", "60.000 ₺", MenuIcons.ArchiveBox, "var(--nexora-teal)"),
    ];

    private static readonly (string Title, string Description, string IconSvg)[] Highlights =
    [
        ("Güvenli Altyapı", "Verileriniz her zaman güvende.", MenuIcons.ShieldCheck),
        ("Hızlı ve Kolay", "İşlerinizi hızla yönetin.", MenuIcons.Bolt),
        ("7/24 Destek", "Her zaman yanınızda.", MenuIcons.QuestionMarkCircle),
    ];
}
