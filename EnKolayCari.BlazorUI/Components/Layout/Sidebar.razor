@using EnKolayCari.BlazorUI.Components.Layout

<div class="flex h-full flex-col bg-gradient-to-b from-nexora-950 to-nexora-900">
    <div class="flex items-center gap-2.5 px-5 py-6">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-brand to-violet text-sm font-bold text-white">EK</span>
        <span class="text-lg font-semibold text-white">EnKolayCari</span>
    </div>

    <nav class="sidebar-scroll flex-1 space-y-6 overflow-y-auto px-3 pb-6">
        @foreach (var group in SidebarMenu.Groups)
        {
            <div>
                <p class="menu-group-label">@group.Label</p>
                <ul class="space-y-1">
                    @foreach (var item in group.Items)
                    {
                        <li>
                            @if (item.Children is { Count: > 0 } children)
                            {
                                var isExpanded = _expanded.Contains(item.Label);
                                <button type="button" class="menu-item justify-between" @onclick="() => Toggle(item.Label)">
                                    <span class="flex items-center gap-3">
                                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)item.IconSvg)</svg>
                                        <span>@item.Label</span>
                                    </span>
                                    <svg class="h-3.5 w-3.5 shrink-0 transition-transform @(isExpanded ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">@((MarkupString)MenuIcons.ChevronDown)</svg>
                                </button>

                                @if (isExpanded)
                                {
                                    <ul class="mt-1 space-y-1 border-l border-white/10 pl-4">
                                        @foreach (var child in children)
                                        {
                                            <li>
                                                <a href="@child.Href" class="menu-item text-sm">
                                                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)child.IconSvg)</svg>
                                                    @child.Label
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                            else if (item.ExactMatch)
                            {
                                <NavLink href="@item.Href" Match="NavLinkMatch.All" class="menu-item" ActiveClass="menu-item--active">
                                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)item.IconSvg)</svg>
                                    @item.Label
                                </NavLink>
                            }
                            else
                            {
                                <a href="@item.Href" class="menu-item">
                                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)item.IconSvg)</svg>
                                    @item.Label
                                </a>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>

    @* <div class="m-3 rounded-2xl bg-white/10 p-4">
        <span class="grid h-9 w-9 place-items-center rounded-lg bg-white/15">
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.Sparkles)</svg>
        </span>
        <p class="mt-2 text-sm font-semibold text-white">Daha fazla özelliğe erişin</p>
        <p class="mt-1 text-xs leading-relaxed text-slate-300">Pro sürüme geçerek premium özelliklerin kilidini açın.</p>
        <a href="#" class="button-light mt-3">
            Hemen Yukselt
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5 19.5 4.5m0 0H8.25m11.25 0v11.25" /></svg>
        </a>
    </div> *@
</div>

@code {
    private readonly HashSet<string> _expanded = [];

    private void Toggle(string label)
    {
        if (!_expanded.Remove(label))
        {
            _expanded.Add(label);
        }
    }
}
