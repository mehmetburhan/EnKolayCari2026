@inject SessionState Session
@implements IDisposable

<div class="relative">
    <button type="button"
            class="flex items-center gap-2 rounded-full border border-[var(--nexora-border)] bg-white py-1 pl-1 pr-1.5 sm:pr-3 hover:border-[var(--nexora-blue)]/40"
            aria-haspopup="true"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="Toggle">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gradient-to-br from-brand to-violet text-xs font-bold text-white">@Initials</span>
        <span class="hidden text-left sm:block">
            <span class="block max-w-[120px] truncate text-xs font-semibold text-slate-900">@Session.UserName</span>
            <span class="block max-w-[120px] truncate text-[11px] text-slate-500">@Session.CompanyName</span>
        </span>
        <svg class="hidden h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform sm:block @(_open ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">@((MarkupString)MenuIcons.ChevronDown)</svg>
    </button>

    @if (_open)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>

        <div class="absolute right-0 top-full z-50 mt-2 w-72 rounded-2xl border border-[var(--nexora-border)] bg-white p-2 shadow-[0_16px_40px_rgba(15,23,42,.12)]" @onclick:stopPropagation="true">
            <div class="flex items-center gap-3 rounded-xl p-2.5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-gradient-to-br from-brand to-violet text-sm font-bold text-white">@Initials</span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-slate-900">@Session.UserName</p>
                    <p class="truncate text-xs text-slate-500">@Session.UserEmail</p>
                </div>
            </div>

            <div class="my-1.5 border-t border-[var(--nexora-border)]"></div>

            <a href="#" class="flex items-center gap-2.5 rounded-xl px-2.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-100">
                <svg class="h-4.5 w-4.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.UserCircle)</svg>
                Profilim
            </a>

            <div class="my-1.5 border-t border-[var(--nexora-border)]"></div>

            <div class="px-2.5 py-1.5">
                <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Dil</p>
                <div class="space-y-0.5">
                    @foreach (var option in _languages)
                    {
                        var isSelected = Session.Language == option.Value;
                        <button type="button"
                                class="flex w-full items-center justify-between rounded-lg px-2.5 py-2 text-sm hover:bg-slate-100 @(isSelected ? "font-semibold text-[var(--nexora-blue)]" : "text-slate-700")"
                                @onclick="() => SelectLanguage(option.Value)">
                            <span class="flex items-center gap-2">
                                <span class="text-base leading-none">@option.Flag</span>
                                @option.Label
                            </span>
                            @if (isSelected)
                            {
                                <svg class="h-4 w-4 text-[var(--nexora-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">@((MarkupString)MenuIcons.Check)</svg>
                            }
                        </button>
                    }
                </div>
            </div>

            <div class="my-1.5 border-t border-[var(--nexora-border)]"></div>

            <NavLink href="auth" class="flex items-center gap-2.5 rounded-xl px-2.5 py-2.5 text-sm font-medium text-red-600 hover:bg-red-50">
                <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.ArrowRightOnRectangle)</svg>
                Oturumu Kapat
            </NavLink>
        </div>
    }
</div>

@code {
    private bool _open;

    private readonly (AppLanguage Value, string Label, string Flag)[] _languages =
    [
        (AppLanguage.Turkish, "Türkçe", "🇹🇷"),
        (AppLanguage.English, "English", "🇬🇧"),
        (AppLanguage.German, "Deutsch", "🇩🇪"),
        (AppLanguage.Russian, "Русский", "🇷🇺"),
    ];

    private string Initials => string.Concat(
        Session.UserName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(part => part.Length > 0)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    protected override void OnInitialized()
    {
        Session.Changed += StateHasChanged;
    }

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void SelectLanguage(AppLanguage language)
    {
        Session.SetLanguage(language);
        _open = false;
    }

    public void Dispose()
    {
        Session.Changed -= StateHasChanged;
    }
}
