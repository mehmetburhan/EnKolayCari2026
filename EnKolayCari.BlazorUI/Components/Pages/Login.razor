@page "/"
@page "/auth"
@layout AuthLayout

<PageTitle>Giriş Yap - En Kolay Cari</PageTitle>

<AuthShell Title="Hesabınıza giriş yapın" Subtitle="İşletmenizi tek yerden yönetin. Daha verimli, daha kolay.">
    <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" class="space-y-5">
        <DataAnnotationsValidator />      

        <div>
            <label class="form-label" for="username">E-posta adresi</label>
            <div class="relative">
                <svg class="pointer-events-none absolute inset-y-0 left-3 my-auto h-4.5 w-4.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.Envelope)</svg>
                <InputText id="username" class="form-input pl-10" placeholder="ornek@firma.com" @bind-Value="_model.Username" />
            </div>
            <ValidationMessage For="() => _model.Username" class="form-error" />
        </div>
        <div>
            <label class="form-label" for="company">Firma</label>
            <div class="relative">
                <svg class="pointer-events-none absolute inset-y-0 left-3 my-auto h-4.5 w-4.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.BuildingOffice)</svg>
                <InputSelect id="company" class="form-input pl-10" @bind-Value="_model.CompanyId">
                    <option value="">Firma seçiniz</option>
                    @foreach (var company in DemoCompanies.All)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </InputSelect>
            </div>
            <ValidationMessage For="() => _model.CompanyId" class="form-error" />
        </div>
        <div>
            <label class="form-label" for="password">Şifre</label>
            <div class="relative">
                <svg class="pointer-events-none absolute inset-y-0 left-3 my-auto h-4.5 w-4.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.LockClosed)</svg>
                <InputText id="password" type="@(_showPassword ? "text" : "password")" class="form-input pl-10 pr-10" placeholder="Şifrenizi girin" @bind-Value="_model.Password" />
                <button type="button" class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-slate-400 hover:text-slate-600" @onclick="() => _showPassword = !_showPassword" aria-label="@(_showPassword ? "Şifreyi gizle" : "Şifreyi göster")">
                    @if (_showPassword)
                    {
                        <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    }
                    else
                    {
                        <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                    }
                </button>
            </div>
            <ValidationMessage For="() => _model.Password" class="form-error" />
        </div>

        <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 text-sm text-slate-600">
                <InputCheckbox class="h-4 w-4 rounded border-[var(--nexora-border)] text-[var(--nexora-blue)]" @bind-Value="_model.RememberMe" />
                Beni hatırla
            </label>
            <NavLink href="forgot-password" class="text-sm font-semibold text-[var(--nexora-blue)] hover:underline">Şifremi unuttum?</NavLink>
        </div>

        @if (_showSuccess)
        {
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700">
                Giriş başarılı (demo). Yönlendiriliyorsunuz...
            </div>
        }

        <button type="submit" class="dashboard-button-primary w-full">
            Giriş Yap
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">@((MarkupString)MenuIcons.ArrowRight)</svg>
        </button>

        <div class="flex items-center gap-3">
            <span class="h-px flex-1 bg-[var(--nexora-border)]"></span>
            <span class="text-xs font-medium text-slate-400">veya</span>
            <span class="h-px flex-1 bg-[var(--nexora-border)]"></span>
        </div>

        <button type="button" class="button-light border border-[var(--nexora-border)]">
            <svg class="h-4 w-4" viewBox="0 0 21 21">
                <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
                <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
                <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
            </svg>
            Microsoft ile giriş yap
        </button>

        <p class="flex items-center justify-center gap-1.5 text-xs text-slate-400">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">@((MarkupString)MenuIcons.ShieldCheck)</svg>
            Güvenliğiniz bizim için önemli.
        </p>
    </EditForm>
</AuthShell>

@code {
    private readonly LoginModel _model = new();
    private bool _showPassword;
    private bool _showSuccess;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task HandleValidSubmit()
    {
        _showSuccess = true;
        StateHasChanged();
        await Task.Delay(700);
        Navigation.NavigateTo("/dashboard");
    }
}
