@page "/bank-reconciliation"

<PageTitle>Banka Mutabakatı - EnKolayCari</PageTitle>
<PageHeading Title="Banka Mutabakatı" Subtitle="Defter bakiyeleri ile banka ekstrelerini karşılaştırın." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Mutabakat Listesi</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_rows.Count kayıt</p>
        </div>
        <LumexButton Color="ThemeColor.Secondary" Size="Size.Small">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            Ekstre Eşleştir
        </LumexButton>
    </div>

    <div class="mt-4">
        <LumexDataGrid Data="@_rows.AsQueryable()" Hoverable Striped>
            <PropertyColumn Property="@(x => x.Account)" Title="Banka Hesabı" />
            <PropertyColumn Property="@(x => x.StatementDate)" Title="Ekstre Tarihi" />
            <PropertyColumn Property="@(x => x.BookBalanceLabel)" Title="Defter Bakiyesi" Align="Align.End" />
            <PropertyColumn Property="@(x => x.BankBalanceLabel)" Title="Banka Bakiyesi" Align="Align.End" />
            <PropertyColumn Property="@(x => x.DifferenceLabel)" Title="Fark" Align="Align.End" />
            <PropertyColumn Property="@(x => x.Status)" Title="Durum" />
        </LumexDataGrid>
    </div>
</div>

@code {
    private record ReconciliationRow(string Account, string StatementDate, string BookBalanceLabel, string BankBalanceLabel, string DifferenceLabel, string Status);

    private readonly List<ReconciliationRow> _rows =
    [
        new("Garanti BBVA - Levent Şubesi", "10 Eki 2026", "₺10.420,30", "₺10.420,30", "₺0,00", "Eşleşti"),
        new("İş Bankası - Merkez Şubesi", "10 Eki 2026", "€7.850,20", "€7.720,20", "€130,00", "Fark Var"),
        new("Akbank - Maslak Şubesi", "09 Eki 2026", "$4.620,15", "$4.620,15", "$0,00", "Eşleşti"),
        new("Yapı Kredi - Kadıköy Şubesi", "08 Eki 2026", "£1.670,10", "£1.640,10", "£30,00", "Fark Var"),
    ];
}
