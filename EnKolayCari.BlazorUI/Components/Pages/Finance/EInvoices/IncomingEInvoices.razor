@page "/e-invoices/incoming"

<PageTitle>Gelen e-Faturalar - EnKolayCari</PageTitle>
<PageHeading Title="Gelen e-Faturalar" Subtitle="Tedarikçilerden gelen e-faturaları görüntüleyin ve onaylayın." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Gelen e-Fatura Listesi</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_invoices.Count kayıt</p>
        </div>
        <button type="button" class="button-secondary">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            GİB'den Senkronize Et
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="IncomingEInvoice" Items="@_invoices" Columns="@_columns" ExportFileName="gelen-e-faturalar" SheetName="Gelen e-Fatura Listesi" EmptyText="Fatura bulunamadı." />
    </div>
</div>

@code {
    private record IncomingEInvoice(string InvoiceNo, string Sender, string GibNo, string Date, string AmountLabel, string Status);

    private readonly List<IncomingEInvoice> _invoices =
    [
        new("EFT-2026-9021", "Mavi Tedarik Ltd.", "GIB2026000091211", "11 Eki 2026", "₺3.205,00", "Onay Bekliyor"),
        new("EFT-2026-9020", "Elektro Dağıtım A.Ş.", "GIB2026000088452", "09 Eki 2026", "₺12.680,00", "Onaylandı"),
        new("EFT-2026-9019", "Orkide Kırtasiye", "GIB2026000087901", "05 Eki 2026", "₺459,90", "Onaylandı"),
        new("EFT-2026-9018", "Kartal Lojistik A.Ş.", "GIB2026000084213", "01 Eki 2026", "₺7.420,50", "Reddedildi"),
    ];

    private readonly List<GridColumn<IncomingEInvoice>> _columns =
    [
        new() { Title = "Fatura No", Property = x => x.InvoiceNo, Filterable = false },
        new() { Title = "Gönderen", Property = x => x.Sender, Filterable = false },
        new() { Title = "GİB No", Property = x => x.GibNo, Filterable = false },
        new() { Title = "Tarih", Property = x => x.Date, Filterable = false },
        new() { Title = "Tutar", Property = x => x.AmountLabel, Align = Align.End, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
