@page "/sales/quotes"
@inject QuoteStore Store
@inject NavigationManager Navigation

<PageTitle>Teklifler - EnKolayCari</PageTitle>
<PageHeading Title="Teklifler" Subtitle="Müşterilerinize gönderdiğiniz satış tekliflerini yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Teklif Listesi</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @Store.Quotes.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary" @onclick="@(() => Navigation.NavigateTo("/sales/quotes/new"))">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Teklif
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="QuoteStore.Quote" Items="@Store.Quotes" Columns="@_columns" ExportFileName="teklifler" SheetName="Teklif Listesi" EmptyText="Teklif bulunamadı."
                     OnEdit="@(item => Navigation.NavigateTo($"/sales/quotes/edit/{Uri.EscapeDataString(item.QuoteNo)}"))" />
    </div>
</div>

@code {
    private readonly List<GridColumn<QuoteStore.Quote>> _columns =
    [
        new() { Title = "Teklif No", Property = x => x.QuoteNo, Filterable = false },
        new() { Title = "Müşteri", Property = x => x.Customer, Filterable = false },
        new() { Title = "Tarih", Property = x => x.Date, Filterable = false },
        new() { Title = "Geçerlilik", Property = x => x.ValidUntil, Filterable = false },
        new() { Title = "Tutar", Property = x => x.AmountLabel, Align = Align.End, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
