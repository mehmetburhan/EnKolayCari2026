@page "/sales/orders"

<PageTitle>Siparişler - EnKolayCari</PageTitle>
<PageHeading Title="Siparişler" Subtitle="Müşteri satış siparişlerinin durumunu takip edin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Sipariş Listesi</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_orders.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Sipariş
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="Order" Items="@_orders" Columns="@_columns" ExportFileName="siparisler" SheetName="Sipariş Listesi" EmptyText="Sipariş bulunamadı." />
    </div>
</div>

@code {
    private record Order(string OrderNo, string Customer, string OrderDate, string DeliveryDate, string AmountLabel, string Status);

    private readonly List<Order> _orders =
    [
        new("SIP-2026-0231", "ABC Ticaret Ltd. Şti.", "06 Eki 2026", "12 Eki 2026", "₺18.400,00", "Hazırlanıyor"),
        new("SIP-2026-0230", "Kartal Lojistik A.Ş.", "05 Eki 2026", "09 Eki 2026", "₺7.850,00", "Sevk Edildi"),
        new("SIP-2026-0229", "Yıldız Elektronik", "04 Eki 2026", "08 Eki 2026", "₺6.250,00", "Tamamlandı"),
        new("SIP-2026-0228", "Mavi Tedarik Ltd.", "02 Eki 2026", "06 Eki 2026", "₺2.980,00", "İptal"),
        new("SIP-2026-0227", "Güneş Tekstil San.", "30 Eyl 2026", "04 Eki 2026", "₺11.760,00", "Tamamlandı"),
    ];

    private readonly List<GridColumn<Order>> _columns =
    [
        new() { Title = "Sipariş No", Property = x => x.OrderNo, Filterable = false },
        new() { Title = "Müşteri", Property = x => x.Customer, Filterable = false },
        new() { Title = "Sipariş Tarihi", Property = x => x.OrderDate, Filterable = false },
        new() { Title = "Teslim Tarihi", Property = x => x.DeliveryDate, Filterable = false },
        new() { Title = "Tutar", Property = x => x.AmountLabel, Align = Align.End, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
