@page "/purchases/invoices"

<PageTitle>Alış Faturaları - EnKolayCari</PageTitle>
<PageHeading Title="Alış Faturaları" Subtitle="Tedarikçilerden gelen alış faturalarını yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Fatura Listesi</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_invoices.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Fatura
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="PurchaseInvoice" Items="@_invoices" Columns="@_columns" ExportFileName="alis-faturalari" SheetName="Fatura Listesi" EmptyText="Fatura bulunamadı." />
    </div>
</div>

@code {
    private record PurchaseInvoice(string InvoiceNo, string Supplier, string Date, string DueDate, string AmountLabel, string Status);

    private readonly List<PurchaseInvoice> _invoices =
    [
        new("ALF-2026-0512", "Mavi Tedarik Ltd.", "10 Eki 2026", "10 Kas 2026", "₺3.205,00", "Ödendi"),
        new("ALF-2026-0511", "Kartal Lojistik A.Ş.", "07 Eki 2026", "07 Kas 2026", "₺7.420,50", "Bekleniyor"),
        new("ALF-2026-0510", "Orkide Kırtasiye", "03 Eki 2026", "03 Kas 2026", "₺459,90", "Ödendi"),
        new("ALF-2026-0509", "Elektro Dağıtım A.Ş.", "28 Eyl 2026", "28 Eki 2026", "₺12.680,00", "Vadesi Geçti"),
    ];

    private readonly List<GridColumn<PurchaseInvoice>> _columns =
    [
        new() { Title = "Fatura No", Property = x => x.InvoiceNo, Filterable = false },
        new() { Title = "Tedarikçi", Property = x => x.Supplier, Filterable = false },
        new() { Title = "Tarih", Property = x => x.Date, Filterable = false },
        new() { Title = "Vade", Property = x => x.DueDate, Filterable = false },
        new() { Title = "Tutar", Property = x => x.AmountLabel, Align = Align.End, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
