@page "/warehouses"
@inject WarehouseStore Store
@inject NavigationManager Navigation

<PageTitle>Depo - EnKolayCari</PageTitle>
<PageHeading Title="Depo" Subtitle="Depo konumlarınızı ve doluluk oranlarını izleyin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Depolar</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @Store.Warehouses.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary" @onclick="@(() => Navigation.NavigateTo("/warehouse/new"))">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Depo
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="WarehouseStore.Warehouse" Items="@Store.Warehouses" Columns="@_columns" ExportFileName="depolar" SheetName="Depolar" EmptyText="Depo bulunamadı."
                     OnEdit="@(item => Navigation.NavigateTo($"/warehouse/edit/{Uri.EscapeDataString(item.Code)}"))" />
    </div>
</div>

@code {
    private readonly List<GridColumn<WarehouseStore.Warehouse>> _columns =
    [
        new() { Title = "Kod", Property = x => x.Code, Filterable = false },
        new() { Title = "Depo Adı", Property = x => x.Name, Filterable = false },
        new() { Title = "Şehir", Property = x => x.City },
        new() { Title = "Sorumlu", Property = x => x.Responsible, Filterable = false },
        new() { Title = "Doluluk", Property = x => x.OccupancyLabel, Align = Align.End, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
