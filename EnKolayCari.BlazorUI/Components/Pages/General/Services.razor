@page "/services"
@inject ServiceStore Store
@inject NavigationManager Navigation

<PageTitle>Hizmet - EnKolayCari</PageTitle>
<PageHeading Title="Hizmet" Subtitle="Faturalandırılabilir hizmet kalemlerinizi yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Hizmetler</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @Store.Services.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary" @onclick='() => Navigation.NavigateTo("/service/new")'>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Hizmet
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="ServiceStore.Service" Items="@Store.Services" Columns="@_columns" ExportFileName="hizmetler" SheetName="Hizmetler" EmptyText="Hizmet bulunamadı." OnEdit="@(item => Navigation.NavigateTo($"/service/edit/{Uri.EscapeDataString(item.Code)}"))" />
    </div>
</div>

@code {
    private readonly List<GridColumn<ServiceStore.Service>> _columns =
    [
        new() { Title = "Kod", Property = x => x.Code, Filterable = false },
        new() { Title = "Hizmet Adı", Property = x => x.Name, Filterable = false },
        new() { Title = "Kategori", Property = x => x.Category },
        new() { Title = "Birim", Property = x => x.Unit },
        new() { Title = "Birim Fiyat", Property = x => x.PriceLabel, Align = Align.End, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
