@page "/sifremi-unuttum"
@layout AuthLayout

<PageTitle>Şifremi Unuttum - EnKolayCari</PageTitle>

<AuthShell Title="Şifremi Unuttum" Subtitle="Kayıtlı kullanıcı adınızı girin, sıfırlama bağlantısı gönderelim.">
    @if (!_submitted)
    {
        <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" class="space-y-5">
            <DataAnnotationsValidator />

            <div>
                <label class="form-label" for="company">Firma</label>
                <InputSelect id="company" class="form-input" @bind-Value="_model.CompanyId">
                    <option value="">Firma seçiniz</option>
                    @foreach (var company in DemoCompanies.All)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.CompanyId" class="form-error" />
            </div>

            <div>
                <label class="form-label" for="usernameOrEmail">Kullanıcı Adı veya E-posta</label>
                <InputText id="usernameOrEmail" class="form-input" placeholder="ornek.kullanici veya ornek@firma.com" @bind-Value="_model.UsernameOrEmail" />
                <ValidationMessage For="() => _model.UsernameOrEmail" class="form-error" />
            </div>

            <button type="submit" class="dashboard-button-primary w-full">Sıfırlama Bağlantısı Gönder</button>

            <NavLink href="auth" class="block text-center text-sm font-semibold text-[var(--nexora-blue)] hover:underline">Giriş sayfasına dön</NavLink>
        </EditForm>
    }
    else
    {
        <div class="space-y-5">
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
                Sıfırlama bağlantısı <strong>@_model.UsernameOrEmail</strong> adresine gönderildi. E-postanızı kontrol edin.
            </div>

            <p class="text-sm text-slate-500">
                (Demo) Gerçek bir e-posta akışı olmadığından, bağlantıya tıklamış gibi devam edebilirsiniz.
            </p>

            <NavLink href="sifre-sifirla" class="dashboard-button-primary w-full">Yeni Şifre Oluştur</NavLink>
            <NavLink href="auth" class="block text-center text-sm font-semibold text-[var(--nexora-blue)] hover:underline">Giriş sayfasına dön</NavLink>
        </div>
    }
</AuthShell>

@code {
    private readonly ForgotPasswordModel _model = new();
    private bool _submitted;

    private void HandleValidSubmit()
    {
        _submitted = true;
    }
}
