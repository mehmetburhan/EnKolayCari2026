@page "/company-settings"

<PageTitle>Firma Ayarları - EnKolayCari</PageTitle>
<PageHeading Title="Firma Ayarları" Subtitle="Firma bilgilerinizi ve şube kayıtlarınızı yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Şubeler</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_branches.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Şube
        </button>
    </div>

    <div class="mt-4">
        <LumexDataGrid Data="@_branches.AsQueryable()" Hoverable Striped>
            <PropertyColumn Property="@(x => x.Code)" Title="Şube Kodu" />
            <PropertyColumn Property="@(x => x.Name)" Title="Şube Adı" />
            <PropertyColumn Property="@(x => x.City)" Title="Şehir" />
            <PropertyColumn Property="@(x => x.TaxOffice)" Title="Vergi Dairesi" />
            <PropertyColumn Property="@(x => x.Manager)" Title="Sorumlu" />
            <PropertyColumn Property="@(x => x.Status)" Title="Durum" />
        </LumexDataGrid>
    </div>
</div>

@code {
    private record Branch(string Code, string Name, string City, string TaxOffice, string Manager, string Status);

    private readonly List<Branch> _branches =
    [
        new("SB-01", "Merkez Şube", "İstanbul", "Levent V.D.", "Celal Dağdeviren", "Aktif"),
        new("SB-02", "Anadolu Yakası Şube", "İstanbul", "Kadıköy V.D.", "Elif Kaya", "Aktif"),
        new("SB-03", "Ege Bölge Şube", "İzmir", "Konak V.D.", "Mert Demir", "Aktif"),
        new("SB-04", "Marmara Şube", "Kocaeli", "İzmit V.D.", "Selin Arslan", "Pasif"),
    ];
}
