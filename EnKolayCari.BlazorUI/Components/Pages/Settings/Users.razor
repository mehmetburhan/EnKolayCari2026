@page "/users"

<PageTitle>Kullanıcılar - EnKolayCari</PageTitle>
<PageHeading Title="Kullanıcılar" Subtitle="Sisteme erişimi olan kullanıcıları ve rollerini yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">Kullanıcı Listesi</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_users.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Kullanıcı
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="UserRow" Items="@_users" Columns="@_columns" ExportFileName="kullanicilar" SheetName="Kullanıcı Listesi" EmptyText="Kullanıcı bulunamadı." />
    </div>
</div>

@code {
    private record UserRow(string Name, string Email, string Role, string Department, string LastLogin, string Status);

    private readonly List<UserRow> _users =
    [
        new("Celal Dağdeviren", "celal@enkolaycari.com", "Yönetici", "Yönetim", "12 Eki 2026 09:02", "Aktif"),
        new("Ahmet Yılmaz", "ahmet.yilmaz@enkolaycari.com", "Depo Sorumlusu", "Depo", "11 Eki 2026 17:45", "Aktif"),
        new("Elif Kaya", "elif.kaya@enkolaycari.com", "Muhasebe", "Finans", "11 Eki 2026 16:20", "Aktif"),
        new("Mert Demir", "mert.demir@enkolaycari.com", "Satış Temsilcisi", "Satış", "10 Eki 2026 14:05", "Aktif"),
        new("Selin Arslan", "selin.arslan@enkolaycari.com", "Depo Sorumlusu", "Depo", "02 Eyl 2026 11:30", "Pasif"),
    ];

    private readonly List<GridColumn<UserRow>> _columns =
    [
        new() { Title = "Ad Soyad", Property = x => x.Name, Filterable = false },
        new() { Title = "E-posta", Property = x => x.Email, Filterable = false },
        new() { Title = "Rol", Property = x => x.Role },
        new() { Title = "Departman", Property = x => x.Department },
        new() { Title = "Son Giriş", Property = x => x.LastLogin, Filterable = false },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
