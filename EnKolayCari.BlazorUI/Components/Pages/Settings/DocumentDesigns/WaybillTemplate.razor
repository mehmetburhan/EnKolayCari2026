@page "/document-designs/waybill"

<PageTitle>İrsaliye Tasarımı - EnKolayCari</PageTitle>
<PageHeading Title="İrsaliye Tasarımı" Subtitle="İrsaliye belge şablonlarınızı yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">İrsaliye Şablonları</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_templates.Count kayıt</p>
        </div>
        <button type="button" class="dashboard-button-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Şablon
        </button>
    </div>

    <div class="mt-4">
        <AppDataGrid TItem="DocumentTemplate" Items="@_templates" Columns="@_columns" ExportFileName="irsaliye-tasarimi" SheetName="İrsaliye Şablonları" EmptyText="Şablon bulunamadı." />
    </div>
</div>

@code {
    private record DocumentTemplate(string Name, string PaperSize, string Language, string LastUpdated, string IsDefaultLabel, string Status);

    private readonly List<DocumentTemplate> _templates =
    [
        new("Standart İrsaliye Şablonu", "A4", "Türkçe", "28 Eyl 2026", "Evet", "Aktif"),
        new("Sevk İrsaliyesi Şablonu", "A4", "Türkçe", "10 Eyl 2026", "Hayır", "Aktif"),
        new("Konsinye İrsaliye Şablonu", "A4", "Türkçe", "30 Ağu 2026", "Hayır", "Pasif"),
    ];

    private readonly List<GridColumn<DocumentTemplate>> _columns =
    [
        new() { Title = "Şablon Adı", Property = x => x.Name, Filterable = false },
        new() { Title = "Kağıt Boyutu", Property = x => x.PaperSize },
        new() { Title = "Dil", Property = x => x.Language },
        new() { Title = "Son Güncelleme", Property = x => x.LastUpdated, Filterable = false },
        new() { Title = "Varsayılan", Property = x => x.IsDefaultLabel },
        new() { Title = "Durum", Property = x => x.Status },
    ];
}
