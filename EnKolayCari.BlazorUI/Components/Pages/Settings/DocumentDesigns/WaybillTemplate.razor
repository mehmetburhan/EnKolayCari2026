@page "/document-designs/waybill"

<PageTitle>İrsaliye Tasarımı - EnKolayCari</PageTitle>
<PageHeading Title="İrsaliye Tasarımı" Subtitle="İrsaliye belge şablonlarınızı yönetin." />

<div class="card p-5">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-base font-semibold text-slate-900">İrsaliye Şablonları</h2>
            <p class="text-xs text-slate-500">Mockup veri &middot; @_templates.Count kayıt</p>
        </div>
        <LumexButton Color="ThemeColor.Primary" Size="Size.Small">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Yeni Şablon
        </LumexButton>
    </div>

    <div class="mt-4">
        <LumexDataGrid Data="@_templates.AsQueryable()" Hoverable Striped>
            <PropertyColumn Property="@(x => x.Name)" Title="Şablon Adı" />
            <PropertyColumn Property="@(x => x.PaperSize)" Title="Kağıt Boyutu" />
            <PropertyColumn Property="@(x => x.Language)" Title="Dil" />
            <PropertyColumn Property="@(x => x.LastUpdated)" Title="Son Güncelleme" />
            <PropertyColumn Property="@(x => x.IsDefaultLabel)" Title="Varsayılan" />
            <PropertyColumn Property="@(x => x.Status)" Title="Durum" />
        </LumexDataGrid>
    </div>
</div>

@code {
    private record DocumentTemplate(string Name, string PaperSize, string Language, string LastUpdated, string IsDefaultLabel, string Status);

    private readonly List<DocumentTemplate> _templates =
    [
        new("Standart İrsaliye Şablonu", "A4", "Türkçe", "28 Eyl 2026", "Evet", "Aktif"),
        new("Sevk İrsaliyesi Şablonu", "A4", "Türkçe", "10 Eyl 2026", "Hayır", "Aktif"),
        new("Konsinye İrsaliye Şablonu", "A4", "Türkçe", "30 Ağu 2026", "Hayır", "Pasif"),
    ];
}
